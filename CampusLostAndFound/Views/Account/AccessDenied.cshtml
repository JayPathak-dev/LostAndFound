@{
    ViewData["Title"] = "Access Denied";
}

<div class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 p-5 bg-white">
                <div class="text-danger mb-3">
                    <i class="bi bi-shield-x display-1"></i>
                </div>
                <h2 class="fw-bold text-slate">Access Denied</h2>
                <p class="text-muted mb-4">
                    You do not have the required administrative or security role privileges to access this resource. All unauthorized access attempts are logged for campus security auditing.
                </p>
                <div class="d-flex justify-content-center gap-3">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-house me-1"></i> Return Home
                    </a>
                    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary">
                        <i class="bi bi-speedometer2 me-1"></i> My Dashboard
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

