@model CampusLostAndFound.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Account Login";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
                <div class="text-center mb-4">
                    <div class="bg-primary-subtle text-primary rounded-circle d-inline-flex p-3 mb-2">
                        <i class="bi bi-person-lock fs-2"></i>
                    </div>
                    <h3 class="fw-bold text-slate">University Portal Login</h3>
                    <p class="text-muted small">Sign in with your campus university credentials</p>
                </div>

                <form asp-action="Login" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ReturnUrl" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold small text-muted"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="bi bi-envelope"></i></span>
                            <input asp-for="Email" class="form-control bg-light border-start-0" placeholder="e.g. john.doe@campus.edu" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-semibold small text-muted"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="bi bi-key"></i></span>
                            <input asp-for="Password" class="form-control bg-light border-start-0" placeholder="Enter password" />
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-4 form-check">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label small text-muted"></label>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
                    </button>
                </form>

                <div class="border-top mt-4 pt-3 text-center">
                    <p class="small text-muted mb-0">
                        Don't have an account?
                        <a asp-action="Register" class="text-primary fw-semibold text-decoration-none">Register as Student/Staff</a>
                    </p>
                </div>

                <div class="mt-4 p-3 bg-light rounded-3 border small">
                    <span class="fw-bold text-secondary d-block mb-1"><i class="bi bi-info-circle me-1"></i> Demo Evaluation Accounts:</span>
                    <ul class="list-unstyled mb-0 small text-muted">
                        <li><strong>System Admin:</strong> <code>sysadmin@campus.edu</code> (Pass: <code>Admin@12345</code>)</li>
                        <li><strong>Campus Admin:</strong> <code>campusadmin@campus.edu</code> (Pass: <code>Admin@12345</code>)</li>
                        <li><strong>Security Officer:</strong> <code>security@campus.edu</code> (Pass: <code>Security@12345</code>)</li>
                        <li><strong>Student:</strong> <code>john.doe@campus.edu</code> (Pass: <code>Student@12345</code>)</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
