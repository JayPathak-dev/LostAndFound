@model List<CampusLostAndFound.Models.AuditEntry>
@{
    ViewData["Title"] = "System Audit Activity Trail";
    string selectedRecord = (string)(ViewBag.SelectedRecord ?? "");
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-slate mb-1">System Audit Activity Trail</h2>
            <p class="text-muted small mb-0">Immutable records of reports, verifications, custody changes, handovers, and disposals.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Admin Overview
        </a>
    </div>

    <!-- Filter by Record Type -->
    <div class="d-flex gap-2 mb-3 flex-wrap">
        <a asp-action="AuditLogs" class="btn btn-sm @(string.IsNullOrEmpty(selectedRecord) ? "btn-primary" : "btn-outline-secondary")">All Actions</a>
        <a asp-action="AuditLogs" asp-route-targetRecord="Item" class="btn btn-sm @(selectedRecord == "Item" ? "btn-primary" : "btn-outline-secondary")">Item Reports</a>
        <a asp-action="AuditLogs" asp-route-targetRecord="Claim" class="btn btn-sm @(selectedRecord == "Claim" ? "btn-primary" : "btn-outline-secondary")">Claims</a>
        <a asp-action="AuditLogs" asp-route-targetRecord="Handover" class="btn btn-sm @(selectedRecord == "Handover" ? "btn-primary" : "btn-outline-secondary")">Handovers</a>
        <a asp-action="AuditLogs" asp-route-targetRecord="DisposalRecord" class="btn btn-sm @(selectedRecord == "DisposalRecord" ? "btn-primary" : "btn-outline-secondary")">Disposals</a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle small">
                    <thead class="table-light">
                        <tr>
                            <th>Audit ID</th>
                            <th>Timestamp (UTC)</th>
                            <th>Action Type</th>
                            <th>Target Entity</th>
                            <th>Actor / Email</th>
                            <th>Audit Details</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in Model)
                        {
                            <tr>
                                <td><strong>#@log.AuditId</strong></td>
                                <td class="text-muted" style="white-space: nowrap;">@log.Timestamp.ToString("MMM dd, yyyy - hh:mm tt")</td>
                                <td>
                                    <span class="badge bg-light text-dark border">@log.Action</span>
                                </td>
                                <td>@log.TargetRecord #@log.TargetRecordId</td>
                                <td>@(log.ActorEmail ?? "System / Auto")</td>
                                <td>@log.AdditionalInformation</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-journal-text display-4 mb-2 d-block"></i>
                <h5>No Audit Records Found</h5>
                <p>No activity has been logged for this filter category.</p>
            </div>
        }
    </div>
</div>
