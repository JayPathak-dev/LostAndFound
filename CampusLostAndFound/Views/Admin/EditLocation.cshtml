@model CampusLostAndFound.ViewModels.LocationFormViewModel
@{
    ViewData["Title"] = $"Edit Location - {Model.BuildingName}";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
                <h3 class="fw-bold text-slate mb-3">Edit Campus Location</h3>

                <form asp-action="EditLocation" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="LocationId" />

                    <div class="mb-3">
                        <label asp-for="BuildingName" class="form-label fw-semibold small text-muted"></label>
                        <input asp-for="BuildingName" class="form-control" />
                        <span asp-validation-for="BuildingName" class="text-danger small"></span>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label asp-for="BlockName" class="form-label fw-semibold small text-muted"></label>
                            <input asp-for="BlockName" class="form-control" />
                            <span asp-validation-for="BlockName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Floor" class="form-label fw-semibold small text-muted"></label>
                            <input asp-for="Floor" class="form-control" />
                            <span asp-validation-for="Floor" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="AreaName" class="form-label fw-semibold small text-muted"></label>
                        <input asp-for="AreaName" class="form-control" />
                        <span asp-validation-for="AreaName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-semibold small text-muted"></label>
                        <textarea asp-for="Description" rows="2" class="form-control"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="mb-4 form-check">
                        <input asp-for="IsActive" class="form-check-input" />
                        <label asp-for="IsActive" class="form-check-label small text-muted"></label>
                    </div>

                    <div class="d-flex justify-content-between align-items-center">
                        <a asp-action="Locations" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4 py-2 fw-semibold">
                            <i class="bi bi-save me-1"></i> Update Location
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

