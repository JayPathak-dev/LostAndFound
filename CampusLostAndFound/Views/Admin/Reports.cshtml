@{
    ViewData["Title"] = "Campus Recovery Reports & Analytics";
    var categoryCounts = ViewBag.CategoryCounts as IEnumerable<dynamic>;
    var locationCounts = ViewBag.LocationCounts as IEnumerable<dynamic>;
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-slate mb-1">Reports & Analytical Metrics</h2>
            <p class="text-muted small mb-0">Quantitative operational data queried directly from SQL Server database entities.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Admin Overview
        </a>
    </div>

    <!-- Comparative Breakdown -->
    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 text-center bg-white">
                <span class="text-muted small fw-semibold text-uppercase">Total Lost</span>
                <h2 class="fw-bold text-danger mt-2 mb-0">@ViewBag.TotalLost</h2>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 text-center bg-white">
                <span class="text-muted small fw-semibold text-uppercase">Total Found</span>
                <h2 class="fw-bold text-success mt-2 mb-0">@ViewBag.TotalFound</h2>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 text-center bg-white">
                <span class="text-muted small fw-semibold text-uppercase">Returned to Owner</span>
                <h2 class="fw-bold text-primary mt-2 mb-0">@ViewBag.TotalReturned</h2>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 text-center bg-white">
                <span class="text-muted small fw-semibold text-uppercase">Authorized Disposal</span>
                <h2 class="fw-bold text-secondary mt-2 mb-0">@ViewBag.TotalDisposed</h2>
            </div>
        </div>
    </div>

    <!-- Tables Breakdown -->
    <div class="row g-4">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
                <h5 class="fw-bold text-slate mb-3 d-flex align-items-center gap-2">
                    <i class="bi bi-tags text-primary"></i> Reports by Category
                </h5>
                <div class="table-responsive">
                    <table class="table table-hover align-middle small">
                        <thead class="table-light">
                            <tr>
                                <th>Category Name</th>
                                <th>Volume</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (categoryCounts != null)
                            {
                                foreach (var cat in categoryCounts)
                                {
                                    <tr>
                                        <td><strong>@cat.Name</strong></td>
                                        <td><span class="badge bg-primary-subtle text-primary border">@cat.Count items</span></td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
                <h5 class="fw-bold text-slate mb-3 d-flex align-items-center gap-2">
                    <i class="bi bi-geo-alt text-danger"></i> Incident Density by Building
                </h5>
                <div class="table-responsive">
                    <table class="table table-hover align-middle small">
                        <thead class="table-light">
                            <tr>
                                <th>Building / Area</th>
                                <th>Volume</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (locationCounts != null)
                            {
                                foreach (var loc in locationCounts)
                                {
                                    <tr>
                                        <td><strong>@loc.Name</strong></td>
                                        <td><span class="badge bg-danger-subtle text-danger border">@loc.Count items</span></td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
