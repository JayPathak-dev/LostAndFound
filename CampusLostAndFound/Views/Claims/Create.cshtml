@model CampusLostAndFound.ViewModels.ClaimCreateViewModel
@{
    ViewData["Title"] = "Submit Ownership Claim";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
                <div class="d-flex align-items-center gap-3 mb-4">
                    <div class="bg-primary-subtle text-primary rounded-circle p-3">
                        <i class="bi bi-hand-index-thumb fs-2"></i>
                    </div>
                    <div>
                        <h2 class="fw-bold text-slate mb-1">Submit Ownership Claim</h2>
                        <p class="text-muted small mb-0">Claiming Item: <strong>@Model.ItemTitle</strong></p>
                    </div>
                </div>

                <!-- Item Summary Card -->
                <div class="p-3 bg-light rounded-3 border mb-4 d-flex align-items-center gap-3">
                    @if (!string.IsNullOrEmpty(Model.ItemImagePath))
                    {
                        <img src="@Model.ItemImagePath" alt="@Model.ItemTitle" class="rounded" style="width: 70px; height: 70px; object-fit: cover;" />
                    }
                    else
                    {
                        <div class="bg-secondary bg-opacity-25 rounded d-flex align-items-center justify-content-center text-muted" style="width: 70px; height: 70px;">
                            <i class="bi bi-image fs-4"></i>
                        </div>
                    }
                    <div>
                        <h6 class="fw-bold mb-1">@Model.ItemTitle</h6>
                        <div class="small text-muted">
                            <span class="me-3"><i class="bi bi-tag text-primary"></i> @Model.ItemCategory</span>
                            <span class="me-3"><i class="bi bi-geo-alt text-danger"></i> @Model.ItemLocation</span>
                            <span><i class="bi bi-clock text-secondary"></i> @Model.FoundDateTime.ToString("g")</span>
                        </div>
                    </div>
                </div>

                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ItemId" />
                    <input type="hidden" asp-for="ItemTitle" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="mb-4">
                        <label asp-for="ClaimDescription" class="form-label fw-semibold text-slate small"></label>
                        <textarea asp-for="ClaimDescription" rows="4" class="form-control" placeholder="Provide detailed explanation demonstrating why this item is yours (e.g. when and where you lost it, contents, receipts, or personal marks)..."></textarea>
                        <span asp-validation-for="ClaimDescription" class="text-danger small"></span>
                    </div>

                    <div class="alert alert-info py-3 px-3 small border-0 mb-4 rounded-3">
                        <i class="bi bi-shield-lock-fill me-1"></i>
                        <strong>Next Step:</strong> After submitting this claim statement, you will be presented with confidential ownership verification questions to confirm your claim against protected item attributes.
                    </div>

                    <div class="d-flex justify-content-between align-items-center">
                        <a asp-controller="Items" asp-action="Details" asp-route-id="@Model.ItemId" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4 py-2 fw-semibold">
                            <i class="bi bi-arrow-right-circle me-1"></i> Submit & Continue to Verification
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

