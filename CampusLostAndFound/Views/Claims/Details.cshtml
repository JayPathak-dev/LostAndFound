@model CampusLostAndFound.ViewModels.ClaimDetailsViewModel
@{
    ViewData["Title"] = $"Claim #{Model.ClaimId} - {Model.ItemTitle}";
}

<div class="container py-4">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="MyClaims">My Claims</a></li>
            <li class="breadcrumb-item active" aria-current="page">Claim #@Model.ClaimId</li>
        </ol>
    </nav>

    <div class="row g-4">
        <!-- Claim Summary & Verification Results -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
                <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
                    <div>
                        <span class="badge badge-status badge-status-@Model.Status fs-6 px-3 py-2">
                            Claim Status: @Model.Status
                        </span>
                        <span class="badge bg-light text-dark border ms-2">Claim ID: #@Model.ClaimId</span>
                    </div>
                    <span class="text-muted small">Submitted on @Model.SubmittedAt.ToString("MMM dd, yyyy - hh:mm tt")</span>
                </div>

                <h3 class="fw-bold text-slate mb-3">@Model.ItemTitle</h3>

                <div class="p-3 bg-light rounded-3 border mb-4">
                    <div class="row g-2 small">
                        <div class="col-sm-6">
                            <span class="text-muted">Item Category:</span> <strong>@Model.ItemCategory</strong>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-muted">Found Campus Location:</span> <strong>@Model.ItemLocation</strong>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-muted">Claimant:</span> <strong>@Model.ClaimantName</strong> (@(Model.ClaimantRegNo ?? "Student/Staff"))
                        </div>
                        <div class="col-sm-6">
                            <span class="text-muted">Current Item State:</span> <span class="badge badge-status badge-status-@Model.ItemStatus">@Model.ItemStatus</span>
                        </div>
                    </div>
                </div>

                <h5 class="fw-bold text-slate mb-2">Claimant Statement</h5>
                <p class="text-muted mb-4" style="line-height: 1.6;">@Model.ClaimDescription</p>

                <!-- Reviewer Notes Section -->
                @if (!string.IsNullOrEmpty(Model.ReviewNotes) || !string.IsNullOrEmpty(Model.ReviewerName))
                {
                    <div class="alert @(Model.Status == "Approved" ? "alert-success" : Model.Status == "Rejected" ? "alert-danger" : "alert-warning") rounded-3 mb-4">
                        <h6 class="fw-bold mb-1 d-flex align-items-center gap-1">
                            <i class="bi bi-person-check-fill me-1"></i> Security / Admin Review Details
                        </h6>
                        <p class="small mb-1">Reviewed By: <strong>@(Model.ReviewerName ?? "Campus Security")</strong> on @Model.ReviewedAt?.ToString("g")</p>
                        @if (!string.IsNullOrEmpty(Model.ReviewNotes))
                        {
                            <p class="mb-0 small"><strong>Official Notes:</strong> @Model.ReviewNotes</p>
                        }
                    </div>
                }

                <!-- Ownership Verification Challenge Results -->
                <h5 class="fw-bold text-slate mb-3 d-flex align-items-center gap-2">
                    <i class="bi bi-shield-check text-primary"></i>
                    Ownership Verification Challenges
                </h5>

                @if (Model.Challenges != null && Model.Challenges.Any())
                {
                    <div class="list-group list-group-flush mb-4">
                        @foreach (var ch in Model.Challenges)
                        {
                            <div class="list-group-item px-0 py-3">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="fw-bold small text-slate">@ch.QuestionPrompt</span>
                                    @if (ch.SimilarityScore.HasValue)
                                    {
                                        <span class="badge @(ch.SimilarityScore >= 70 ? "bg-success" : ch.SimilarityScore >= 40 ? "bg-warning text-dark" : "bg-danger")">
                                            Score: @ch.SimilarityScore%
                                        </span>
                                    }
                                </div>
                                <div class="p-2 bg-light rounded border small">
                                    <span class="text-muted d-block">Submitted Response:</span>
                                    <span class="text-slate">@(string.IsNullOrWhiteSpace(ch.SubmittedAnswer) ? "No answer submitted yet." : ch.SubmittedAnswer)</span>
                                </div>

                                @if (!string.IsNullOrEmpty(ch.ExpectedReference))
                                {
                                    <div class="p-2 mt-2 bg-warning-subtle rounded border border-warning small text-dark">
                                        <span class="fw-bold text-warning-emphasis d-block"><i class="bi bi-lock-fill me-1"></i> Confidential Expected Attribute (Reviewer Eyes Only):</span>
                                        <span>@ch.ExpectedReference</span>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="alert alert-light border small text-muted mb-4">
                        No additional verification challenges were required for this item.
                    </div>
                }

                <!-- Handover Summary Section -->
                @if (Model.HandoverCompleted && Model.HandoverDetails != null)
                {
                    <div class="card border-success rounded-3 p-3 bg-success bg-opacity-10 mb-3">
                        <h6 class="fw-bold text-success mb-2 d-flex align-items-center gap-2">
                            <i class="bi bi-check-circle-fill"></i>
                            Supervised Handover Confirmed & Completed
                        </h6>
                        <div class="row g-2 small text-dark">
                            <div class="col-sm-6">
                                <span class="text-muted">Handover Date:</span> <strong>@Model.HandoverDetails.HandoverDateTime.ToString("f")</strong>
                            </div>
                            <div class="col-sm-6">
                                <span class="text-muted">Supervising Officer:</span> <strong>@Model.HandoverDetails.SecurityOfficerName</strong>
                            </div>
                            <div class="col-sm-6">
                                <span class="text-muted">Proof Reference:</span> <strong>@Model.HandoverDetails.ProofReference</strong>
                            </div>
                            @if (!string.IsNullOrEmpty(Model.HandoverDetails.Notes))
                            {
                                <div class="col-12">
                                    <span class="text-muted">Handover Remarks:</span> <span>@Model.HandoverDetails.Notes</span>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Action / Status Sidebar -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white sticky-top" style="top: 1rem;">
                <h5 class="fw-bold text-slate mb-3">Claim Actions</h5>

                @if (Model.Status == "Pending" || Model.Status == "UnderVerification")
                {
                    <a asp-controller="Verification" asp-action="Challenge" asp-route-claimId="@Model.ClaimId" class="btn btn-outline-primary w-100 mb-3">
                        <i class="bi bi-pencil-square me-1"></i> Update Verification Answers
                    </a>
                }

                @if (Model.CanReview)
                {
                    <a asp-controller="Security" asp-action="ReviewClaim" asp-route-claimId="@Model.ClaimId" class="btn btn-warning w-100 py-2 fw-semibold mb-3">
                        <i class="bi bi-shield-check me-1"></i> Review & Decide Claim
                    </a>
                }

                @if (Model.CanInitiateHandover)
                {
                    <a asp-controller="Security" asp-action="Handover" asp-route-claimId="@Model.ClaimId" class="btn btn-success w-100 py-2 fw-semibold mb-3">
                        <i class="bi bi-arrow-left-right me-1"></i> Execute Supervised Handover
                    </a>
                }

                <a asp-controller="Items" asp-action="Details" asp-route-id="@Model.ItemId" class="btn btn-outline-secondary w-100">
                    <i class="bi bi-eye me-1"></i> View Item Details
                </a>
            </div>
        </div>
    </div>
</div>
