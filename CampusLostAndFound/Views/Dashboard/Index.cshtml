@model CampusLostAndFound.ViewModels.UserDashboardViewModel
@{
    ViewData["Title"] = "My Campus Dashboard";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-slate mb-1">Student & Staff Dashboard</h2>
            <p class="text-muted small mb-0">Track your submitted reports, active ownership claims, and automated match recommendations.</p>
        </div>
        <div class="d-flex gap-2 mt-3 mt-sm-0">
            <a asp-controller="Items" asp-action="ReportLost" class="btn btn-outline-danger">
                <i class="bi bi-exclamation-octagon me-1"></i> Report Lost Item
            </a>
            <a asp-controller="Items" asp-action="ReportFound" class="btn btn-success">
                <i class="bi bi-plus-circle me-1"></i> Report Found Item
            </a>
        </div>
    </div>

    <!-- Overview Statistics Cards -->
    <div class="row g-4 mb-4">
        <div class="col-6 col-md-3">
            <div class="stats-card">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="stats-label mb-0">My Lost Reports</span>
                    <i class="bi bi-exclamation-triangle text-danger fs-4"></i>
                </div>
                <div class="stats-number text-danger">@Model.TotalLostReports</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="stats-card">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="stats-label mb-0">My Found Reports</span>
                    <i class="bi bi-box-seam text-success fs-4"></i>
                </div>
                <div class="stats-number text-success">@Model.TotalFoundReports</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="stats-card">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="stats-label mb-0">Active Claims</span>
                    <i class="bi bi-hand-index-thumb text-primary fs-4"></i>
                </div>
                <div class="stats-number text-primary">@Model.ActiveClaimsCount</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="stats-card">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="stats-label mb-0">Recovered Items</span>
                    <i class="bi bi-check-circle text-info fs-4"></i>
                </div>
                <div class="stats-number text-info">@Model.ItemsRecoveredCount</div>
            </div>
        </div>
    </div>

    <!-- Match Suggestions Banner (if any) -->
    @if (Model.MatchSuggestions.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold text-slate mb-0 d-flex align-items-center gap-2">
                    <i class="bi bi-stars text-warning fs-4"></i>
                    Intelligent Match Suggestions (@Model.MatchSuggestions.Count)
                </h5>
                <a asp-action="Matches" class="btn btn-sm btn-outline-primary">View All Matches</a>
            </div>
            <p class="small text-muted mb-3">Our rule-based engine scored these correlations between your reports and opposite campus listings:</p>

            <div class="row g-3">
                @foreach (var match in Model.MatchSuggestions)
                {
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded-3 border h-100 d-flex flex-column justify-content-between">
                            <div>
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <span class="badge @(match.MatchScore >= 75 ? "bg-success" : "bg-primary")">
                                        @match.MatchScore% Match
                                    </span>
                                    <span class="badge bg-secondary-subtle text-dark border small">@match.CategoryName</span>
                                </div>
                                <h6 class="fw-bold mb-1">@match.FoundItemTitle</h6>
                                <p class="small text-muted mb-2">@match.MatchReason</p>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top">
                                <span class="small text-muted"><i class="bi bi-geo-alt text-danger me-1"></i>@match.LocationName</span>
                                <a asp-controller="Items" asp-action="Details" asp-route-id="@match.FoundItemId" class="btn btn-sm btn-outline-primary">
                                    View Found Item <i class="bi bi-arrow-right ms-1"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <!-- Recent Reports & Claims Grid -->
    <div class="row g-4">
        <!-- My Recent Reports -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold text-slate mb-0">My Reported Items</h5>
                    <a asp-action="MyReports" class="btn btn-sm btn-link text-decoration-none">View All</a>
                </div>

                @if (Model.MyRecentReports.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle small mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Item</th>
                                    <th>Type</th>
                                    <th>Status</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.MyRecentReports)
                                {
                                    <tr>
                                        <td>
                                            <strong>@item.Title</strong>
                                            <div class="text-muted small">@item.CategoryName &bull; @item.LocationName</div>
                                        </td>
                                        <td>
                                            <span class="badge badge-type-@item.ReportType">@item.ReportType</span>
                                        </td>
                                        <td>
                                            <span class="badge badge-status badge-status-@item.Status">@item.Status</span>
                                        </td>
                                        <td>
                                            <a asp-controller="Items" asp-action="Details" asp-route-id="@item.ItemId" class="btn btn-sm btn-light border" title="Details">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-4 text-muted small">
                        <i class="bi bi-journal-text fs-2 d-block mb-2"></i>
                        You have not submitted any item reports yet.
                    </div>
                }
            </div>
        </div>

        <!-- My Recent Claims -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold text-slate mb-0">My Ownership Claims</h5>
                    <a asp-action="MyClaims" class="btn btn-sm btn-link text-decoration-none">View All</a>
                </div>

                @if (Model.MyRecentClaims.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle small mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Claimed Item</th>
                                    <th>Status</th>
                                    <th>Submitted</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var claim in Model.MyRecentClaims)
                                {
                                    <tr>
                                        <td>
                                            <strong>@claim.ItemTitle</strong>
                                            <div class="text-muted small">@claim.CategoryName</div>
                                        </td>
                                        <td>
                                            <span class="badge badge-status badge-status-@claim.Status">@claim.Status</span>
                                        </td>
                                        <td class="text-muted">@claim.SubmittedAt.ToString("MMM dd")</td>
                                        <td>
                                            <a asp-controller="Claims" asp-action="Details" asp-route-id="@claim.ClaimId" class="btn btn-sm btn-light border" title="View Claim">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-4 text-muted small">
                        <i class="bi bi-hand-index-thumb fs-2 d-block mb-2"></i>
                        You have not submitted any ownership claims yet.
                    </div>
                }
            </div>
        </div>
    </div>
</div>
