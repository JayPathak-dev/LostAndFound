@model List<CampusLostAndFound.ViewModels.MatchSuggestionCardViewModel>
@{
    ViewData["Title"] = "Intelligent Match Suggestions";
}

<div class="container py-4">
    <div class="mb-4">
        <h2 class="fw-bold text-slate mb-1">Intelligent Match Recommendations</h2>
        <p class="text-muted small mb-0">Correlations identified by our rule-based scoring engine between your lost reports and registered found items.</p>
    </div>

    @if (Model.Any())
    {
        <div class="row g-4">
            @foreach (var match in Model)
            {
                <div class="col-md-6">
                    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100 d-flex flex-column justify-content-between">
                        <div>
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <span class="badge @(match.MatchScore >= 75 ? "bg-success" : match.MatchScore >= 60 ? "bg-primary" : "bg-warning text-dark") px-3 py-2 fs-6">
                                    @match.MatchScore% Match Score
                                </span>
                                <span class="badge bg-light text-muted border">@match.CategoryName</span>
                            </div>

                            <div class="p-3 bg-light rounded-3 border mb-3">
                                <div class="small text-muted">Your Lost Report:</div>
                                <h6 class="fw-bold text-danger mb-2"><i class="bi bi-exclamation-octagon me-1"></i> @match.LostItemTitle</h6>
                                <div class="small text-muted">Discovered Found Report:</div>
                                <h6 class="fw-bold text-success mb-0"><i class="bi bi-box-seam me-1"></i> @match.FoundItemTitle</h6>
                            </div>

                            <h6 class="fw-bold text-slate small mb-1">Scoring Breakdown:</h6>
                            <p class="small text-muted mb-3" style="line-height: 1.5;">@match.MatchReason</p>
                        </div>

                        <div class="d-flex justify-content-between align-items-center pt-3 border-top mt-auto">
                            <span class="small text-muted"><i class="bi bi-geo-alt text-danger me-1"></i>@match.LocationName</span>
                            <div class="d-flex gap-2">
                                <a asp-controller="Items" asp-action="Details" asp-route-id="@match.FoundItemId" class="btn btn-sm btn-outline-secondary">
                                    <i class="bi bi-eye me-1"></i> Inspect
                                </a>
                                <a asp-controller="Claims" asp-action="Create" asp-route-itemId="@match.FoundItemId" class="btn btn-sm btn-primary">
                                    <i class="bi bi-hand-index-thumb me-1"></i> Claim
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white">
            <i class="bi bi-stars text-muted display-4 mb-3"></i>
            <h4 class="fw-bold text-secondary">No High-Confidence Matches Found</h4>
            <p class="text-muted">Our matching engine constantly analyzes new submissions. When an item matching your description is registered, it will appear here automatically.</p>
        </div>
    }
</div>

