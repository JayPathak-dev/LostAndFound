@{
    ViewData["Title"] = "Campus Security & Custody Desk";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
                <div class="text-center mb-4">
                    <div class="bg-primary-subtle text-primary rounded-circle d-inline-flex p-3 mb-2">
                        <i class="bi bi-shield-check fs-1"></i>
                    </div>
                    <h2 class="fw-bold text-slate">Campus Security & Custody Desk</h2>
                    <p class="text-muted">For immediate physical inquiry, item collection, or emergency assistance.</p>
                </div>

                <div class="row g-4 mb-4">
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded-3 border h-100">
                            <h6 class="fw-bold text-primary"><i class="bi bi-geo-alt-fill me-1"></i> Physical Custody Center</h6>
                            <p class="small text-muted mb-0">
                                Campus Security Main Control Station<br />
                                Ground Floor, Administration Complex<br />
                                Open 24 Hours, 7 Days a week
                            </p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded-3 border h-100">
                            <h6 class="fw-bold text-primary"><i class="bi bi-telephone-fill me-1"></i> Direct Helplines</h6>
                            <p class="small text-muted mb-0">
                                Emergency Line: <strong>+91 1800-CAMPUS-SEC</strong><br />
                                Lost & Found Room: Ext. 4022<br />
                                Email: <strong>security.custody@campus.edu</strong>
                            </p>
                        </div>
                    </div>
                </div>

                <div class="alert alert-info border-0 rounded-3 small">
                    <i class="bi bi-info-circle-fill me-1"></i> <strong>Item Collection Notice:</strong> To collect an approved item, you must present a valid university student/staff ID card or government-issued photo identity proof at the security desk during handover.
                </div>
            </div>
        </div>
    </div>
</div>
