@model List<CampusLostAndFound.ViewModels.ItemCardViewModel>
@{
    ViewData["Title"] = "Campus Lost and Found Management Platform";
}

<!-- Hero Section -->
<section class="hero-section text-center text-lg-start">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-7">
                <span class="badge bg-primary-subtle text-primary-emphasis px-3 py-2 rounded-pill fw-semibold mb-3">
                    <i class="bi bi-shield-lock me-1"></i> University Belonging Management
                </span>
                <h1 class="hero-title text-white">Lost Something on Campus?<br /><span class="text-info">Let's Help You Find It.</span></h1>
                <p class="hero-subtitle">
                    A smarter, structured, and safer university platform to report, discover, and recover misplaced belongings through private ownership verification and supervised physical handover.
                </p>
                <div class="d-flex flex-wrap gap-3 justify-content-center justify-content-lg-start">
                    <a asp-controller="Items" asp-action="ReportLost" class="btn btn-lg btn-danger px-4 shadow-sm">
                        <i class="bi bi-exclamation-octagon me-2"></i> Report Lost Item
                    </a>
                    <a asp-controller="Items" asp-action="ReportFound" class="btn btn-lg btn-success px-4 shadow-sm">
                        <i class="bi bi-plus-circle me-2"></i> Report Found Item
                    </a>
                    <a asp-controller="Items" asp-action="Index" class="btn btn-lg btn-outline-light px-4">
                        <i class="bi bi-search me-2"></i> Browse Found Items
                    </a>
                </div>
            </div>
            <div class="col-lg-5 mt-5 mt-lg-0 text-center">
                <div class="p-4 bg-white bg-opacity-10 rounded-4 border border-white border-opacity-10 backdrop-blur">
                    <i class="bi bi-box2-heart text-info display-1"></i>
                    <h4 class="text-white fw-bold mt-3">Campus Safe Custody</h4>
                    <p class="text-light-emphasis small mb-0">
                        Found items are placed under verified security custody. Private details are strictly protected to ensure only true owners can claim their items.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Real Database Statistics Section -->
<section class="py-5 bg-white border-bottom">
    <div class="container">
        <div class="row g-4 text-center">
            <div class="col-6 col-md-3">
                <div class="stats-card h-100">
                    <div class="text-primary mb-2">
                        <i class="bi bi-search fs-2"></i>
                    </div>
                    <div class="stats-number">@ViewBag.TotalLost</div>
                    <div class="stats-label">Total Lost Reports</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="stats-card h-100">
                    <div class="text-success mb-2">
                        <i class="bi bi-box-seam fs-2"></i>
                    </div>
                    <div class="stats-number">@ViewBag.TotalFound</div>
                    <div class="stats-label">Total Found Reports</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="stats-card h-100">
                    <div class="text-info mb-2">
                        <i class="bi bi-check2-circle fs-2"></i>
                    </div>
                    <div class="stats-number text-success">@ViewBag.TotalReturned</div>
                    <div class="stats-label">Items Returned</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="stats-card h-100">
                    <div class="text-warning mb-2">
                        <i class="bi bi-hourglass-split fs-2"></i>
                    </div>
                    <div class="stats-number text-warning">@ViewBag.PendingClaims</div>
                    <div class="stats-label">Pending Claims</div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- How It Works Section -->
<section class="py-5 bg-light">
    <div class="container">
        <div class="text-center mb-5">
            <h6 class="text-primary fw-bold text-uppercase tracking-wide">Structured Workflow</h6>
            <h2 class="fw-bold text-slate">How Campus Recovery Works</h2>
            <p class="text-muted mx-auto" style="max-width: 600px;">
                Replacing informal WhatsApp messages and lost registers with a transparent, verifiable four-stage lifecycle.
            </p>
        </div>

        <div class="row g-4">
            <div class="col-md-3">
                <div class="card h-100 border-0 shadow-sm p-4 text-center rounded-4">
                    <div class="bg-primary-subtle text-primary rounded-circle d-inline-flex align-items-center justify-content-center mx-auto mb-3" style="width: 60px; height: 60px;">
                        <i class="bi bi-pencil-square fs-3"></i>
                    </div>
                    <h5 class="fw-bold">1. Report Misplaced Item</h5>
                    <p class="text-muted small">
                        Log lost or found items with location, timestamp, and photographs. Found reports include confidential verification details.
                    </p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card h-100 border-0 shadow-sm p-4 text-center rounded-4">
                    <div class="bg-info-subtle text-info rounded-circle d-inline-flex align-items-center justify-content-center mx-auto mb-3" style="width: 60px; height: 60px;">
                        <i class="bi bi-cpu fs-3"></i>
                    </div>
                    <h5 class="fw-bold">2. Rule-Based Matching</h5>
                    <p class="text-muted small">
                        Our C# weighted matching engine calculates similarity scores across category, campus location, title, and timestamp proximity.
                    </p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card h-100 border-0 shadow-sm p-4 text-center rounded-4">
                    <div class="bg-warning-subtle text-warning-emphasis rounded-circle d-inline-flex align-items-center justify-content-center mx-auto mb-3" style="width: 60px; height: 60px;">
                        <i class="bi bi-shield-lock fs-3"></i>
                    </div>
                    <h5 class="fw-bold">3. Private Verification</h5>
                    <p class="text-muted small">
                        Claimants answer dynamic challenges (marks, scratches, contents) derived from hidden attributes without leaking expected answers.
                    </p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card h-100 border-0 shadow-sm p-4 text-center rounded-4">
                    <div class="bg-success-subtle text-success rounded-circle d-inline-flex align-items-center justify-content-center mx-auto mb-3" style="width: 60px; height: 60px;">
                        <i class="bi bi-people fs-3"></i>
                    </div>
                    <h5 class="fw-bold">4. Supervised Handover</h5>
                    <p class="text-muted small">
                        Campus security officers verify student credentials, supervise the handover, release custody, and log audit history.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Recently Reported Found Items -->
<section class="py-5 bg-white">
    <div class="container">
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
            <div>
                <h6 class="text-primary fw-bold text-uppercase tracking-wide">Live Campus Board</h6>
                <h2 class="fw-bold text-slate mb-0">Recently Found Belongings</h2>
            </div>
            <a asp-controller="Items" asp-action="Index" class="btn btn-outline-primary mt-2 mt-sm-0">
                View All Found Items <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>

        @if (Model != null && Model.Any())
        {
            <div class="row g-4">
                @foreach (var item in Model)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="item-card">
                            <div class="item-card-img-wrapper">
                                @if (!string.IsNullOrEmpty(item.ImagePath))
                                {
                                    <img src="@item.ImagePath" alt="@item.Title" class="item-card-img" />
                                }
                                else
                                {
                                    <i class="bi bi-image item-card-placeholder"></i>
                                }
                                <div class="position-absolute top-0 start-0 m-2">
                                    <span class="badge bg-success bg-opacity-75">Found</span>
                                </div>
                                <div class="position-absolute top-0 end-0 m-2">
                                    <span class="badge badge-status badge-status-@item.Status">@item.Status</span>
                                </div>
                            </div>
                            <div class="item-card-body">
                                <h5 class="item-card-title">@item.Title</h5>
                                <p class="item-card-desc">@item.Description</p>
                                <div class="mt-auto">
                                    <div class="item-meta-item">
                                        <i class="bi bi-tag text-primary"></i>
                                        <span>@item.CategoryName</span>
                                    </div>
                                    <div class="item-meta-item">
                                        <i class="bi bi-geo-alt text-danger"></i>
                                        <span>@item.LocationName</span>
                                    </div>
                                    <div class="item-meta-item">
                                        <i class="bi bi-clock text-secondary"></i>
                                        <span>@item.ItemDateTime.ToString("MMM dd, yyyy - hh:mm tt")</span>
                                    </div>
                                    <div class="d-flex gap-2 mt-3">
                                        <a asp-controller="Items" asp-action="Details" asp-route-id="@item.ItemId" class="btn btn-sm btn-outline-secondary w-100">
                                            <i class="bi bi-info-circle me-1"></i> Details
                                        </a>
                                        <a asp-controller="Claims" asp-action="Create" asp-route-itemId="@item.ItemId" class="btn btn-sm btn-primary w-100">
                                            <i class="bi bi-hand-index-thumb me-1"></i> Claim Item
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-5 bg-light rounded-4">
                <i class="bi bi-inbox text-muted display-4"></i>
                <h5 class="fw-bold mt-3 text-secondary">No Found Items Reported Yet</h5>
                <p class="text-muted">Be the first to report a found belonging to assist your campus peers.</p>
                <a asp-controller="Items" asp-action="ReportFound" class="btn btn-primary">Report Found Item</a>
            </div>
        }
    </div>
</section>
