@model CampusLostAndFound.ViewModels.ItemSearchViewModel
@{
    ViewData["Title"] = "Public Item Board - Campus Found Items";
}

<div class="container py-4">
    <!-- Header Banner -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-slate mb-1">Public Found Items Board</h2>
            <p class="text-muted small mb-0">Browse and search active found belongings registered across university buildings</p>
        </div>
        <div class="d-flex gap-2 mt-3 mt-sm-0">
            <a asp-controller="Items" asp-action="ReportFound" class="btn btn-success">
                <i class="bi bi-plus-circle me-1"></i> Report Found Item
            </a>
            <a asp-controller="Items" asp-action="ReportLost" class="btn btn-outline-danger">
                <i class="bi bi-exclamation-octagon me-1"></i> Report Lost Item
            </a>
        </div>
    </div>

    <!-- Search & Filter Bar -->
    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
        <form asp-action="Index" method="get">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label small fw-semibold text-muted">Keyword Search</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-search"></i></span>
                        <input asp-for="SearchTerm" class="form-control bg-light border-start-0" placeholder="Search by item name, brand, color..." />
                    </div>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold text-muted">Category</label>
                    <select asp-for="CategoryId" asp-items="Model.Categories" class="form-select bg-light">
                        <option value="">-- All Categories --</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold text-muted">Campus Location</label>
                    <select asp-for="LocationId" asp-items="Model.Locations" class="form-select bg-light">
                        <option value="">-- All Locations --</option>
                    </select>
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <div class="w-100 d-flex gap-2">
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="bi bi-funnel me-1"></i> Filter
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary" title="Clear Filters">
                            <i class="bi bi-arrow-clockwise"></i>
                        </a>
                    </div>
                </div>
            </div>
        </form>
    </div>

    <!-- Results Header -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <span class="text-muted small">
            Showing <strong>@Model.Items.Count</strong> of <strong>@Model.TotalItems</strong> found belongings
        </span>
    </div>

    <!-- Item Cards Grid -->
    @if (Model.Items.Any())
    {
        <div class="row g-4">
            @foreach (var item in Model.Items)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="item-card">
                        <div class="item-card-img-wrapper">
                            @if (!string.IsNullOrEmpty(item.ImagePath))
                            {
                                <img src="@item.ImagePath" alt="@item.Title" class="item-card-img" />
                            }
                            else
                            {
                                <i class="bi bi-image item-card-placeholder"></i>
                            }
                            <div class="position-absolute top-0 start-0 m-2">
                                <span class="badge bg-success bg-opacity-75">Found</span>
                            </div>
                            <div class="position-absolute top-0 end-0 m-2">
                                <span class="badge badge-status badge-status-@item.Status">@item.Status</span>
                            </div>
                        </div>
                        <div class="item-card-body">
                            <h5 class="item-card-title">@item.Title</h5>
                            <p class="item-card-desc">@item.Description</p>
                            <div class="mt-auto">
                                <div class="item-meta-item">
                                    <i class="bi bi-tag text-primary"></i>
                                    <span>@item.CategoryName</span>
                                </div>
                                <div class="item-meta-item">
                                    <i class="bi bi-geo-alt text-danger"></i>
                                    <span>@item.LocationName</span>
                                </div>
                                <div class="item-meta-item">
                                    <i class="bi bi-clock text-secondary"></i>
                                    <span>@item.ItemDateTime.ToString("MMM dd, yyyy - hh:mm tt")</span>
                                </div>
                                <div class="d-flex gap-2 mt-3">
                                    <a asp-action="Details" asp-route-id="@item.ItemId" class="btn btn-sm btn-outline-secondary w-100">
                                        <i class="bi bi-eye me-1"></i> View Details
                                    </a>
                                    <a asp-controller="Claims" asp-action="Create" asp-route-itemId="@item.ItemId" class="btn btn-sm btn-primary w-100">
                                        <i class="bi bi-hand-index-thumb me-1"></i> Claim Item
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Pagination -->
        @if (Model.TotalPages > 1)
        {
            <nav class="mt-5 d-flex justify-content-center" aria-label="Page navigation">
                <ul class="pagination shadow-sm">
                    <li class="page-item @(Model.PageNumber == 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index"
                           asp-route-PageNumber="@(Model.PageNumber - 1)"
                           asp-route-SearchTerm="@Model.SearchTerm"
                           asp-route-CategoryId="@Model.CategoryId"
                           asp-route-LocationId="@Model.LocationId">Previous</a>
                    </li>
                    @for (int p = 1; p <= Model.TotalPages; p++)
                    {
                        <li class="page-item @(p == Model.PageNumber ? "active" : "")">
                            <a class="page-link" asp-action="Index"
                               asp-route-PageNumber="@p"
                               asp-route-SearchTerm="@Model.SearchTerm"
                               asp-route-CategoryId="@Model.CategoryId"
                               asp-route-LocationId="@Model.LocationId">@p</a>
                        </li>
                    }
                    <li class="page-item @(Model.PageNumber == Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Index"
                           asp-route-PageNumber="@(Model.PageNumber + 1)"
                           asp-route-SearchTerm="@Model.SearchTerm"
                           asp-route-CategoryId="@Model.CategoryId"
                           asp-route-LocationId="@Model.LocationId">Next</a>
                    </li>
                </ul>
            </nav>
        }
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white">
            <i class="bi bi-search text-muted display-4 mb-3"></i>
            <h4 class="fw-bold text-secondary">No Matching Found Items</h4>
            <p class="text-muted">No items matched your current search filters. Try adjusting keywords or clearing category constraints.</p>
            <div>
                <a asp-action="Index" class="btn btn-outline-primary">Reset All Filters</a>
            </div>
        </div>
    }
</div>
