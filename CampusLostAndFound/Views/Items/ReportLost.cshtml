@model CampusLostAndFound.ViewModels.ItemCreateViewModel
@{
    ViewData["Title"] = "Report Lost Item";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
                <div class="d-flex align-items-center gap-3 mb-4">
                    <div class="bg-danger-subtle text-danger rounded-circle p-3">
                        <i class="bi bi-exclamation-octagon fs-2"></i>
                    </div>
                    <div>
                        <h2 class="fw-bold text-slate mb-1">Report a Lost Belonging</h2>
                        <p class="text-muted small mb-0">Provide details of your misplaced article. Our rule-based matching engine will search for matching found reports.</p>
                    </div>
                </div>

                <form asp-action="ReportLost" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ReportType" value="Lost" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-semibold text-slate small"></label>
                        <input asp-for="Title" class="form-control" placeholder="e.g. Dell Inspiron 15 Laptop Charger" />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="CategoryId" class="form-label fw-semibold text-slate small"></label>
                            <select asp-for="CategoryId" asp-items="Model.Categories" class="form-select">
                                <option value="">-- Select Category --</option>
                            </select>
                            <span asp-validation-for="CategoryId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="LocationId" class="form-label fw-semibold text-slate small"></label>
                            <select asp-for="LocationId" asp-items="Model.Locations" class="form-select">
                                <option value="">-- Select Approximate Location --</option>
                            </select>
                            <span asp-validation-for="LocationId" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="ItemDateTime" class="form-label fw-semibold text-slate small">Date & Time Misplaced</label>
                            <input asp-for="ItemDateTime" type="datetime-local" class="form-control" />
                            <span asp-validation-for="ItemDateTime" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ImageFile" class="form-label fw-semibold text-slate small"></label>
                            <input asp-for="ImageFile" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp" />
                            <span class="text-muted small">JPG, PNG, or WEBP up to 5 MB.</span>
                            <span asp-validation-for="ImageFile" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Description" class="form-label fw-semibold text-slate small"></label>
                        <textarea asp-for="Description" rows="4" class="form-control" placeholder="Describe the item in detail: color, brand, model, where you last had it..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-danger px-4 py-2 fw-semibold">
                            <i class="bi bi-send me-1"></i> Submit Lost Report
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
