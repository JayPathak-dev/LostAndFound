@model CampusLostAndFound.ViewModels.CustodyAssignViewModel
@{
    ViewData["Title"] = "Log Item into Security Custody";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
                <div class="d-flex align-items-center gap-3 mb-4">
                    <div class="bg-primary-subtle text-primary rounded-circle p-3">
                        <i class="bi bi-archive-fill fs-2"></i>
                    </div>
                    <div>
                        <h3 class="fw-bold text-slate mb-1">Assign Physical Custody</h3>
                        <p class="text-muted small mb-0">Record physical locker location and custody custody custody of <strong>@Model.ItemTitle</strong></p>
                    </div>
                </div>

                <form asp-action="AssignCustody" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ItemId" />
                    <input type="hidden" asp-for="ItemTitle" />

                    <div class="mb-3">
                        <label asp-for="CustodyLocation" class="form-label fw-semibold text-slate small"></label>
                        <input asp-for="CustodyLocation" class="form-control" placeholder="e.g., Central Security Desk Locker C-04" />
                        <span asp-validation-for="CustodyLocation" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Notes" class="form-label fw-semibold text-slate small"></label>
                        <textarea asp-for="Notes" rows="3" class="form-control" placeholder="e.g., Item received in intact condition, sealed in evidence pouch..."></textarea>
                        <span asp-validation-for="Notes" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4 py-2 fw-semibold">
                            <i class="bi bi-save me-1"></i> Confirm Custody Receipt
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

