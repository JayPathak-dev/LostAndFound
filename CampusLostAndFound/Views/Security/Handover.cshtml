@model CampusLostAndFound.ViewModels.HandoverCreateViewModel
@{
    ViewData["Title"] = "Supervised Item Handover";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
                <div class="d-flex align-items-center gap-3 mb-4">
                    <div class="bg-success-subtle text-success rounded-circle p-3">
                        <i class="bi bi-arrow-left-right fs-2"></i>
                    </div>
                    <div>
                        <h2 class="fw-bold text-slate mb-1">Supervised Physical Handover</h2>
                        <p class="text-muted small mb-0">Record physical handover of item <strong>@Model.ItemTitle</strong></p>
                    </div>
                </div>

                <!-- Verified Owner Summary Card -->
                <div class="p-3 bg-light rounded-3 border mb-4">
                    <h6 class="fw-bold text-slate mb-2">Verified Owner Information</h6>
                    <div class="row g-2 small">
                        <div class="col-sm-6">
                            <span class="text-muted">Full Name:</span> <strong>@Model.ClaimantName</strong>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-muted">University Reg #:</span> <strong>@(Model.ClaimantRegNo ?? "N/A")</strong>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-muted">Email:</span> <strong>@Model.ClaimantEmail</strong>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-muted">Phone:</span> <strong>@(Model.ClaimantPhone ?? "N/A")</strong>
                        </div>
                    </div>
                </div>

                <form asp-action="Handover" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ClaimId" />
                    <input type="hidden" asp-for="ItemId" />
                    <input type="hidden" asp-for="ItemTitle" />
                    <input type="hidden" asp-for="ClaimantName" />

                    <div class="mb-3">
                        <label asp-for="ProofReference" class="form-label fw-semibold text-slate small"></label>
                        <input asp-for="ProofReference" class="form-control" placeholder="e.g. Student ID Card 21BCE1042 verified / Slip #482" />
                        <span asp-validation-for="ProofReference" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Notes" class="form-label fw-semibold text-slate small"></label>
                        <textarea asp-for="Notes" rows="3" class="form-control" placeholder="e.g., Item verified by owner in person. Owner signed physical acknowledgement receipt..."></textarea>
                        <span asp-validation-for="Notes" class="text-danger small"></span>
                    </div>

                    <div class="alert alert-warning small border-0 rounded-3 mb-4">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i>
                        <strong>Legal & System Effect:</strong> Confirming this handover will transactionally update the item status to <strong>Returned</strong>, release active security custody records, and log an indelible audit trail.
                    </div>

                    <div class="d-flex justify-content-between align-items-center">
                        <a asp-action="PendingClaims" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-success px-4 py-2 fw-semibold">
                            <i class="bi bi-check2-circle me-1"></i> Confirm Physical Handover
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
