@model CampusLostAndFound.ViewModels.SecurityDashboardViewModel
@{
    ViewData["Title"] = "Campus Security Desk Dashboard";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <span class="badge bg-warning text-dark px-3 py-1 rounded-pill fw-semibold mb-1">
                <i class="bi bi-shield-lock-fill me-1"></i> Security Desk Control
            </span>
            <h2 class="fw-bold text-slate mb-1">Custody & Handover Operations</h2>
            <p class="text-muted small mb-0">Manage physical item custody, evaluate ownership claims, and execute supervised returns.</p>
        </div>
        <div class="d-flex gap-2 mt-3 mt-sm-0">
            <a asp-action="PendingClaims" class="btn btn-warning fw-semibold">
                <i class="bi bi-clock-history me-1"></i> Review Pending Claims (@Model.PendingClaimsCount)
            </a>
            <a asp-action="CustodyList" class="btn btn-outline-secondary">
                <i class="bi bi-archive me-1"></i> Custody Locker
            </a>
        </div>
    </div>

    <!-- Security KPI Metric Cards -->
    <div class="row g-4 mb-4">
        <div class="col-6 col-md-3">
            <div class="stats-card">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="stats-label mb-0">Items in Custody</span>
                    <i class="bi bi-archive-fill text-primary fs-4"></i>
                </div>
                <div class="stats-number text-primary">@Model.ItemsInCustodyCount</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="stats-card">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="stats-label mb-0">Claims to Review</span>
                    <i class="bi bi-hourglass-split text-warning fs-4"></i>
                </div>
                <div class="stats-number text-warning">@Model.PendingClaimsCount</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="stats-card">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="stats-label mb-0">Awaiting Handover</span>
                    <i class="bi bi-arrow-left-right text-success fs-4"></i>
                </div>
                <div class="stats-number text-success">@Model.ApprovedAwaitingHandoverCount</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="stats-card">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="stats-label mb-0">Total Returned</span>
                    <i class="bi bi-check2-circle text-info fs-4"></i>
                </div>
                <div class="stats-number text-info">@Model.TotalReturnedCount</div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Pending Claims Queue -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold text-slate mb-0 d-flex align-items-center gap-2">
                        <i class="bi bi-clock-history text-warning"></i>
                        Pending Ownership Claims
                    </h5>
                    <a asp-action="PendingClaims" class="btn btn-sm btn-link text-decoration-none">View All</a>
                </div>

                @if (Model.PendingClaims.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle small mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Item</th>
                                    <th>Claimant</th>
                                    <th>Status</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var claim in Model.PendingClaims)
                                {
                                    <tr>
                                        <td>
                                            <strong>@claim.ItemTitle</strong>
                                            <div class="text-muted small">@claim.ItemLocation</div>
                                        </td>
                                        <td>
                                            <strong>@claim.ClaimantName</strong>
                                            <div class="text-muted small">@(claim.ClaimantRegNo ?? "Student")</div>
                                        </td>
                                        <td>
                                            <span class="badge badge-status badge-status-@claim.Status">@claim.Status</span>
                                        </td>
                                        <td>
                                            <a asp-action="ReviewClaim" asp-route-claimId="@claim.ClaimId" class="btn btn-sm btn-warning">
                                                Review
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-4 text-muted small">
                        <i class="bi bi-check-circle text-success fs-3 d-block mb-1"></i>
                        All submitted claims have been processed!
                    </div>
                }
            </div>
        </div>

        <!-- Approved Claims Awaiting Physical Handover -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold text-slate mb-0 d-flex align-items-center gap-2">
                        <i class="bi bi-arrow-left-right text-success"></i>
                        Ready for Physical Handover
                    </h5>
                    <a asp-action="HandoverHistory" class="btn btn-sm btn-link text-decoration-none">History</a>
                </div>

                @if (Model.ApprovedClaimsForHandover.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle small mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Item</th>
                                    <th>Owner</th>
                                    <th>Approved</th>
                                    <th>Handover</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var claim in Model.ApprovedClaimsForHandover)
                                {
                                    <tr>
                                        <td><strong>@claim.ItemTitle</strong></td>
                                        <td>
                                            <strong>@claim.ClaimantName</strong>
                                            <div class="text-muted small">@(claim.ClaimantRegNo ?? "ID Verified")</div>
                                        </td>
                                        <td class="text-muted small">@claim.ReviewedAt?.ToString("MMM dd")</td>
                                        <td>
                                            <a asp-action="Handover" asp-route-claimId="@claim.ClaimId" class="btn btn-sm btn-success fw-semibold">
                                                <i class="bi bi-hand-thumbs-up me-1"></i> Supervise
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-4 text-muted small">
                        <i class="bi bi-inbox fs-3 d-block mb-1"></i>
                        No approved claims waiting for physical handover.
                    </div>
                }
            </div>
        </div>
    </div>
</div>
