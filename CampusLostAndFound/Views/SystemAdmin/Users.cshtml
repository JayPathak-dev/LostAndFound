@model List<CampusLostAndFound.Controllers.UserManagementViewModel>
@{
    ViewData["Title"] = "User & Role Management";
    var allRoles = ViewBag.AllRoles as string[] ?? new string[0];
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-slate mb-1">User & Role Management</h2>
            <p class="text-muted small mb-0">Assign authorized security and administrative roles to registered university accounts.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Console Overview
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>User</th>
                        <th>Registration #</th>
                        <th>Phone</th>
                        <th>Current Role</th>
                        <th>Status</th>
                        <th>Assign New Role</th>
                        <th>Toggle Active</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td>
                                <strong>@user.FullName</strong>
                                <div class="text-muted small">@user.Email</div>
                            </td>
                            <td>@(user.RegistrationNumber ?? "-")</td>
                            <td>@(user.PhoneNumber ?? "-")</td>
                            <td>
                                <span class="badge @(user.CurrentRole == "SystemAdministrator" ? "bg-dark" : user.CurrentRole == "CampusAdministrator" ? "bg-primary" : user.CurrentRole == "SecurityPersonnel" ? "bg-warning text-dark" : "bg-light text-muted border")">
                                    @user.CurrentRole
                                </span>
                            </td>
                            <td>
                                @if (user.IsActive)
                                {
                                    <span class="badge bg-success-subtle text-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger">Deactivated</span>
                                }
                            </td>
                            <td>
                                <form asp-action="ChangeRole" method="post" class="d-flex gap-2">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="userId" value="@user.UserId" />
                                    <select name="newRole" class="form-select form-select-sm" style="width: auto;">
                                        @foreach (var r in allRoles)
                                        {
                                            <option value="@r" selected="@(user.CurrentRole == r)">@r</option>
                                        }
                                    </select>
                                    <button type="submit" class="btn btn-sm btn-outline-primary" title="Update Role">
                                        Update
                                    </button>
                                </form>
                            </td>
                            <td>
                                <form asp-action="ToggleUserStatus" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="userId" value="@user.UserId" />
                                    <button type="submit" class="btn btn-sm @(user.IsActive ? "btn-outline-danger" : "btn-outline-success")">
                                        @(user.IsActive ? "Deactivate" : "Activate")
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

